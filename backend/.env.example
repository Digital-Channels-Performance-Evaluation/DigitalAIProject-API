DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/digital_channels_db
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000
WATCH_DATA_FOLDER=true
SCAN_INTERVAL_SECONDS=30

# ML Training Configuration
# Set to 'true' in development to auto-train models on every data upload
# Set to 'false' in production to train only on demand (recommended for efficiency)
# Use POST /api/ml/train-all to manually trigger training when needed
AUTO_TRAIN_ON_UPLOAD=false
