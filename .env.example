# ============================================================
# Ahadu Bank Platform — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ahadu_bank_eval
MYSQL_USER=ahadu_user
MYSQL_PASSWORD=change_me_db_password
DATABASE_URL=mysql+pymysql://ahadu_user:change_me_db_password@mysql:3306/ahadu_bank_eval

# ── JWT / Auth ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET

# ── Redis ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/2

# ── App ─────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost","http://127.0.0.1:3000"]

# ── HTTPS (production) ──────────────────────────────────────
# Path to your TLS certificate and key (mounted into the nginx container)
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
# DOMAIN=yourdomain.com

# ── Email / SMTP ─────────────────────────────────────────────
# Fill these in to enable alert email notifications to managers.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
